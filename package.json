{
  "name": "architectai-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "ArchitectAI — Engineering Intelligence Platform Kernel",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "tsc -b",
    "dev": "pnpm --filter @architectai/web dev",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:arch": "vitest run tests/architecture",
    "cli:skeleton": "pnpm --filter @architectai/cli skeleton",
    "web:dev": "pnpm --filter @architectai/web dev",
    "web:build": "pnpm --filter @architectai/web build",
    "web:start": "pnpm --filter @architectai/web start"
  },
  "devDependencies": {
    "@architectai/domain": "workspace:*",
    "@architectai/knowledge": "workspace:*",
    "@types/node": "^22.13.9",
    "playwright": "^1.63.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
