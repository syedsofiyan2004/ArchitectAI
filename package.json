{
  "name": "architectai-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "ArchitectAI — Engineering Intelligence Platform Kernel",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:arch": "vitest run tests/architecture",
    "cli:skeleton": "pnpm --filter @architectai/cli skeleton"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "tsx": "^4.19.3",
    "@types/node": "^22.13.9"
  }
}
